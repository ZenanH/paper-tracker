# Host directory mounted at /data inside the container. Must exist and be writable.
PAPER_TRACKER_DATA_DIR=/data
# scripts/deploy.sh detects the host Tailscale IPv4 and binds this port to it.
PAPER_TRACKER_PORT=8899
PAPER_TRACKER_UID=1000
PAPER_TRACKER_GID=1000

# Optional Crossref contact information. Not displayed in the UI.
CROSSREF_MAILTO=

# Translation and filter model settings are configured in the web UI.
