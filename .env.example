# Site binding
# Fill with the result of: tailscale ip -4
PAPER_TRACKER_TAILSCALE_IP=
PAPER_TRACKER_PORT=8899

# Host ownership and persistent storage paths
PAPER_TRACKER_UID=1000
PAPER_TRACKER_GID=1000
PAPER_TRACKER_DATA_DIR=./data
PAPER_TRACKER_ARCHIVE_DIR=./archive
PAPER_TRACKER_SECRETS_DIR=./secrets

# Collection configuration
CROSSREF_MAILTO=

# Public OAuth app Client ID; enable Device Flow. Can also be entered in Settings.
PAPER_TRACKER_GITHUB_CLIENT_ID=

# 翻译与过滤模型在网页右上角“设置”中配置。
